<script>
const menuBtn=document.getElementById('menuBtn'), nav=document.getElementById('navLinks');menuBtn.addEventListener('click',()=>{const open=nav.classList.toggle('open');menuBtn.setAttribute('aria-expanded',String(open));menuBtn.textContent=open?'✕ Cerrar':'☰ Menú'});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');menuBtn.setAttribute('aria-expanded','false');menuBtn.textContent='☰ Menú'}));
// Efecto sonoro generado localmente con Web Audio; no necesita descargar archivos.
let audioCtx=null,playing=false,oscillators=[],gainNodes=[],stopTimer=null;const soundBtn=document.getElementById('soundBtn');function stopSound(){oscillators.forEach(o=>{try{o.stop()}catch(e){}});oscillators=[];gainNodes=[];playing=false;soundBtn.textContent='▶ Reproducir sonido';if(stopTimer)clearTimeout(stopTimer)}soundBtn.addEventListener('click',async()=>{if(playing){stopSound();return}try{audioCtx=audioCtx||new (window.AudioContext||window.webkitAudioContext)();await audioCtx.resume();playing=true;soundBtn.textContent='■ Detener sonido';const now=audioCtx.currentTime;[220,330,440,660].forEach((freq,i)=>{const osc=audioCtx.createOscillator(),gain=audioCtx.createGain();osc.type=i%2?'sine':'triangle';osc.frequency.setValueAtTime(freq,now+i*.17);gain.gain.setValueAtTime(.0001,now);gain.gain.exponentialRampToValueAtTime(.055,now+.08+i*.04);gain.gain.exponentialRampToValueAtTime(.0001,now+2.2);osc.connect(gain);gain.connect(audioCtx.destination);osc.start(now+i*.17);osc.stop(now+2.3);oscillators.push(osc);gainNodes.push(gain)});stopTimer=setTimeout(()=>{playing=false;soundBtn.textContent='▶ Reproducir sonido'},2500)}catch(e){soundBtn.textContent='El audio no está disponible en este navegador'}});
const feedback=document.getElementById('feedback'),answerButtons=[...document.querySelectorAll('.answer')];answerButtons.forEach(b=>b.addEventListener('click',()=>{answerButtons.forEach(x=>x.classList.remove('selected'));b.classList.add('selected');feedback.textContent=b.dataset.correct==='true'?'¡Correcto! El calor fluye espontáneamente desde una temperatura mayor hacia una menor.':'Inténtalo otra vez. Piensa en la diferencia de temperatura entre dos cuerpos.';feedback.style.color=b.dataset.correct==='true'?'#276749':'#64140D'}));document.getElementById('resetQuiz').addEventListener('click',()=>{answerButtons.forEach(x=>x.classList.remove('selected'));feedback.textContent='';});const backTop=document.getElementById('backTop');window.addEventListener('scroll',()=>{backTop.style.display=window.scrollY>500?'block':'none'});backTop.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));
</script></body></html>